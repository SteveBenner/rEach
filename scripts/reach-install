#!/usr/bin/env ruby

require "fileutils"
require "json"
require "net/http"
require "zlib"
require "optparse"
require "securerandom"
require "tmpdir"
require "uri"
require "open3"
require "rbconfig"
require "timeout"
require "digest"
require "time"
require "yaml"

module ReachInstall
  MAX_BYTES = 100 * 1024 * 1024
  MAX_UNPACKED_BYTES = 500 * 1024 * 1024
  MAX_ATTEMPTS = 3
  CONNECT_TIMEOUT_S = 10
  READ_TIMEOUT_S = 60
  MIN_DOWNLOAD_INTERVAL_S = 1
  PROFILE_FOLDER_ID = [0x5E6C858F, 0x0E22, 0x4760, 0x9A, 0xFE, 0xEA, 0x33, 0x17, 0xB6, 0x71, 0x73].freeze
  HOME_MISSING = "rEach could not find your user folder on this computer, so it did not create anything. Close this app, open it again from your own Windows account, and send your message again. If this keeps happening, tell your instructor.".freeze
  SENSITIVE_FLAG = /key|token|code|password|secret|passphrase|passkey/i
  ENV_KEEP = /\A(?:PATH|HOME|USERPROFILE|SHELL|LANG|LC_ALL|TERM|TMPDIR|TEMP|XDG_[A-Z_]+|RUBY[A-Z_]*|GEM_[A-Z_]+|BUNDLE_[A-Z_]+|REACH_[A-Z_]+|CLAUDE[A-Z_]*|CODEX[A-Z_]*|HERMES[A-Z_]*|ANTIGRAVITY[A-Z_]*|HTTP_PROXY|HTTPS_PROXY|NO_PROXY|SSL_CERT_FILE|SSL_CERT_DIR)\z/i
  ENV_DROP = /token|key|secret|password|passphrase|signature|pem|credential|passkey|course_code|enroll_code|enrollment_code/i
  LOG_THRESHOLD = 3
  LOG_FAILURES_KEPT = 10
  LOG_LOCK_WAIT_S = 2.0

  class << self
    def run(argv)
      log_begin(argv)
      code = nil
      begin
        code = execute(argv)
      ensure
        log_finish(code)
      end
      code
    end

    def execute(argv)
      options = parse(argv)
      log_start(options)
      raise "REACH_INSTALL_KILL_SWITCH=1 prevents archive downloads" if ENV["REACH_INSTALL_KILL_SWITCH"] == "1" && !options[:archive]

      destination = File.expand_path(options[:destination])
      parent = File.dirname(destination)
      refuse_missing_home(destination)
      FileUtils.mkdir_p(parent)

      Dir.mktmpdir("reach-install-", parent) do |temp|
        reach_root = stage(url: options[:url], temp: temp, archive: options[:archive], revision: options[:revision])
        install(reach_root, destination)
      end
      record_destination(destination)
      puts "rEach installed at #{destination}"
      codex_step(destination)
      0
    rescue StandardError => e
      @log_error = e
      warn "reach-install: #{e.message}"
      1
    end

    def stage(url:, temp:, archive: nil, revision: nil)
      raise "REACH_INSTALL_KILL_SWITCH=1 prevents archive downloads" if ENV["REACH_INSTALL_KILL_SWITCH"] == "1" && !archive

      FileUtils.mkdir_p(temp)
      reach_archive = archive || download(url, temp, "reach.zip")
      reach_root = logged_extract(reach_archive, File.join(temp, "reach"))
      revision_value = read_revision(revision || File.join(reach_root, "dovetail-revision.txt"))
      dovetail_url = "https://github.com/SteveBenner/dovetail/archive/#{revision_value}.zip"
      dovetail_archive = download(dovetail_url, temp, "dovetail.zip")
      dovetail_root = logged_extract(dovetail_archive, File.join(temp, "dovetail"))
      dovetail_destination = File.join(reach_root, "dovetail")
      if File.directory?(dovetail_destination) && !File.symlink?(dovetail_destination) && Dir.empty?(dovetail_destination)
        Dir.rmdir(dovetail_destination)
      elsif File.exist?(dovetail_destination) || File.symlink?(dovetail_destination)
        raise "archive already contains a Dovetail directory"
      end

      began = log_clock
      FileUtils.mv(dovetail_root, dovetail_destination)
      log_step("move", began, "what" => "dovetail")
      reach_root
    end

    private

    def windows_host?
      RbConfig::CONFIG["host_os"].to_s =~ /mswin|mingw|cygwin/ ? true : false
    end

    def windows_slashes(path)
      text = path.to_s.strip.tr("\\", "/")
      match = text.match(%r{\A/([A-Za-z])(?:/(.*))?\z})
      return text unless match

      "#{match[1].upcase}:/#{match[2]}"
    end

    def known_folder_profile
      require "fiddle"

      shell32 = Fiddle.dlopen("shell32.dll")
      ole32 = Fiddle.dlopen("ole32.dll")
      fetch = Fiddle::Function.new(shell32["SHGetKnownFolderPath"], [Fiddle::TYPE_VOIDP, Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP, Fiddle::TYPE_VOIDP], Fiddle::TYPE_INT)
      release = Fiddle::Function.new(ole32["CoTaskMemFree"], [Fiddle::TYPE_VOIDP], Fiddle::TYPE_VOID)
      slot = Fiddle::Pointer.malloc(Fiddle::SIZEOF_VOIDP, Fiddle::RUBY_FREE)
      address = 0
      begin
        result = fetch.call(PROFILE_FOLDER_ID.pack("VvvC8"), 0, nil, slot)
        return nil unless (result & 0xFFFFFFFF).zero?

        address = slot[0, Fiddle::SIZEOF_VOIDP].unpack("J").first
        return nil if address.zero?

        wide = Fiddle::Pointer.new(address)
        bytes = "".b
        index = 0
        while index < 32_768
          unit = wide[index * 2, 2]
          break if unit == "\0\0".b

          bytes << unit
          index += 1
        end
        windows_slashes(bytes.force_encoding(Encoding::UTF_16LE).encode(Encoding::UTF_8))
      ensure
        release.call(Fiddle::Pointer.new(address)) unless address.zero?
      end
    rescue StandardError, LoadError
      nil
    end

    def registry_profile
      out = Timeout.timeout(5) do
        text, _status = Open3.capture2("reg.exe", "query", "HKCU\\Volatile Environment", "/v", "USERPROFILE", err: File::NULL)
        text
      end
      pattern = /\A\s*USERPROFILE\s+REG_(?:EXPAND_)?SZ\s+/i
      line = out.to_s.lines.find { |entry| entry =~ pattern }
      line ? windows_slashes(line.sub(pattern, "")) : nil
    rescue StandardError, Timeout::Error
      nil
    end

    def user_home
      @user_home ||= begin
        found = nil
        if windows_host?
          [-> { known_folder_profile }, -> { registry_profile }, -> { windows_slashes(ENV["USERPROFILE"]) }].each do |finder|
            path = finder.call.to_s
            next if path.empty? || !File.directory?(path)

            found = path
            break
          end
        end
        found || File.expand_path("~")
      end
    end

    def expand_home(value)
      text = value.to_s
      return File.join(user_home, text[1..-1].to_s) if text == "~" || text.start_with?("~/") || text.start_with?("~\\")

      File.expand_path(text)
    end

    def home_anchor
      home_value = ENV["REACH_HOME"].to_s
      return File.dirname(expand_home(home_value)) unless home_value.empty?

      workspace_value = ENV["REACH_WORKSPACE_ROOT"].to_s
      return File.dirname(expand_home(workspace_value)) unless workspace_value.empty?

      user_home
    end

    def refuse_missing_home(destination)
      anchor = home_anchor
      return if File.directory?(anchor)

      left = destination.to_s
      right = anchor.to_s
      if windows_host?
        left = left.downcase
        right = right.downcase
      end
      return unless left == right || left.start_with?("#{right.chomp('/')}/")

      raise HOME_MISSING
    end

    def log_clock
      Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end

    def log_enabled?
      ENV["REACH_SETUP_LOG"].to_s != "0"
    end

    def log_home
      @log_home || File.dirname(default_destination)
    rescue StandardError
      nil
    end

    def log_dir
      home = log_home
      home ? File.join(home, "setup-log") : nil
    end

    def log_ensure_dir
      folder = log_dir
      return nil unless folder
      return nil unless File.directory?(home_anchor)

      FileUtils.mkdir_p(folder, mode: 0o700)
      File.chmod(0o700, folder)
      folder
    rescue StandardError, NotImplementedError
      nil
    end

    def log_write(record)
      return nil unless log_enabled?

      folder = log_ensure_dir
      return nil unless folder

      @log_file ||= File.join(folder, "install-#{Time.now.utc.strftime("%Y%m%dT%H%M%SZ")}.jsonl")
      line = JSON.generate(log_homeless({ "at" => Time.now.utc.iso8601(3), "pid" => Process.pid }.merge(record)))
      File.open(@log_file, File::WRONLY | File::CREAT | File::APPEND, 0o600) { |file| file.write("#{line}\n") }
      nil
    rescue StandardError, NotImplementedError
      nil
    end

    def log_home_prefixes
      list = [(user_home rescue nil), ENV["HOME"], ENV["USERPROFILE"]].compact.map { |home| home.to_s.tr("\\", "/").chomp("/") }
      list.reject { |home| home.length < 3 }.uniq.sort_by { |home| -home.length }
    end

    def log_homeless(value)
      case value
      when Hash
        value.each_with_object({}) { |(key, item), out| out[key] = log_homeless(item) }
      when Array
        value.map { |item| log_homeless(item) }
      when String
        text = value
        log_home_prefixes.each do |home|
          [home, home.tr("/", "\\")].uniq.each do |form|
            text = text.gsub(/#{Regexp.escape(form)}(?=[\\\/]|\z|[^A-Za-z0-9._-])/i, "~")
          end
        end
        text
      else
        value
      end
    rescue StandardError
      value
    end

    def log_text(value)
      text = value.to_s.dup
      text = text.encode("UTF-8", invalid: :replace, undef: :replace, replace: "?") unless text.encoding == Encoding::UTF_8 && text.valid_encoding?
      text = text.gsub(%r{(?<=://)[^/@\s]+@}, "[scrubbed]@")
      text = text.gsub(/-----BEGIN [A-Z0-9 ]+-----.*?(?:-----END [A-Z0-9 ]+-----|\z)/m, "[scrubbed]")
      text.gsub(/[A-Z0-9]{3,}-[A-Z0-9]{4}-[A-Z0-9]{4}/, "[scrubbed]")
    end

    def log_argv(argv)
      hide = false
      Array(argv).map do |token|
        token = token.to_s
        if token.start_with?("--")
          flag, given = token.split("=", 2)
          sensitive = SENSITIVE_FLAG.match?(flag)
          hide = sensitive && given.nil?
          given.nil? ? log_text(flag) : (sensitive ? "#{flag}=[redacted]" : log_text(token))
        elsif hide
          hide = false
          "[redacted]"
        else
          log_text(token)
        end
      end
    end

    def log_env
      ENV.to_h.select { |name, _| ENV_KEEP.match?(name) }.each_with_object({}) do |(name, value), memo|
        memo[name] = ENV_DROP.match?(name) ? "[redacted]" : log_text(value)
      end
    end

    def log_begin(argv)
      @log_started = log_clock
      @log_argv = log_argv(argv)
      @log_error = nil
      @log_began = false
    end

    def log_start(options)
      @log_destination = File.expand_path(options[:destination])
      @log_home = File.dirname(@log_destination)
      return if @log_began

      @log_began = true
      log_write(
        "kind" => "start", "argv" => @log_argv, "destination" => File.expand_path(options[:destination]),
        "url" => log_text(options[:url]), "archive" => options[:archive] ? true : false,
        "ruby" => { "version" => RUBY_VERSION, "platform" => RUBY_PLATFORM, "patchlevel" => RUBY_PATCHLEVEL, "executable" => RbConfig.ruby },
        "ruby_platform" => RUBY_PLATFORM, "env" => log_env, "cwd" => (Dir.pwd rescue nil), "script" => $PROGRAM_NAME
      )
    end

    def log_step(step, began, fields = {})
      log_write({ "kind" => "step", "step" => step, "duration_ms" => ((log_clock - began) * 1000).round }.merge(fields))
    end

    def logged_extract(archive, destination)
      began = log_clock
      root = extract_archive(archive, destination)
      log_step("extract", began, "archive" => File.basename(archive), "bytes" => (File.size(archive) rescue nil))
      root
    rescue StandardError => e
      log_step("extract", began, "archive" => File.basename(archive), "error" => log_text(e.class.name), "message" => log_text(e.message))
      raise
    end

    def log_finish(code)
      error = @log_error || $!
      success = code == 0 && error.nil?
      unless @log_began
        @log_home ||= nil
        @log_began = true
        log_write("kind" => "start", "argv" => @log_argv)
      end
      record = {
        "kind" => "end", "outcome" => success ? "success" : "failure", "exit" => code,
        "duration_ms" => ((log_clock - @log_started) * 1000).round
      }
      if error
        record["error"] = {
          "class" => error.class.name, "message" => log_text(error.message),
          "backtrace" => Array(error.backtrace).first(100).map { |frame| log_text(frame) }
        }
      end
      log_write(record)
      log_streak(success, error)
    rescue StandardError
      nil
    end

    def log_threshold
      path = File.join(@log_destination || File.join(log_home.to_s, "plugin"), "config.yml")
      data = File.file?(path) ? YAML.safe_load(File.read(path)) : nil
      section = data.is_a?(Hash) ? data["setup_log"] : nil
      value = section.is_a?(Hash) ? section["threshold"].to_i : 0
      value.positive? ? value : LOG_THRESHOLD
    rescue StandardError
      LOG_THRESHOLD
    end

    def log_streak(success, error)
      return nil unless log_enabled?

      folder = log_ensure_dir
      return nil unless folder

      streak = 0
      path = File.join(folder, "state.json")
      File.open(File.join(folder, "lock"), File::RDWR | File::CREAT, 0o600) do |handle|
        locked = false
        deadline = log_clock + LOG_LOCK_WAIT_S
        until locked || log_clock >= deadline
          locked = handle.flock(File::LOCK_EX | File::LOCK_NB)
          sleep(0.02) unless locked
        end
        state = begin
          parsed = JSON.parse(File.read(path))
          parsed.is_a?(Hash) ? parsed : {}
        rescue StandardError
          {}
        end
        if success
          state["streak"] = 0
          state["last_success_at"] = Time.now.utc.iso8601(3)
        else
          state["streak"] = state["streak"].to_i + 1
          failures = Array(state["failures"])
          failures << { "at" => Time.now.utc.iso8601(3), "where" => "installer", "error" => error ? log_text(error.class.name) : "exit" }
          state["failures"] = failures.last(LOG_FAILURES_KEPT)
        end
        streak = state["streak"]
        tmp = "#{path}.tmp.#{Process.pid}"
        File.open(tmp, File::WRONLY | File::CREAT | File::TRUNC, 0o600) { |file| file.write(JSON.generate(state)) }
        File.rename(tmp, path)
        handle.flock(File::LOCK_UN) if locked
      end
      threshold = log_threshold
      if !success && streak.positive? && (streak % threshold).zero?
        warn "rEach has hit a problem #{streak} times in a row while getting set up. Once it runs, `reach debug export` saves a report for your instructor in Downloads."
      end
      nil
    rescue StandardError, NotImplementedError
      nil
    end

    def default_destination
      home_value = ENV["REACH_HOME"].to_s
      return File.join(expand_home(home_value), "plugin") unless home_value.empty?

      workspace_value = ENV["REACH_WORKSPACE_ROOT"].to_s
      workspace = expand_home(workspace_value.empty? ? "~/reach-work" : workspace_value)
      legacy = File.join(user_home, ".reach")
      return File.join(legacy, "plugin") if legacy_active?(workspace, legacy)

      File.join(workspace, ".reach-home", "plugin")
    end

    def legacy_active?(workspace, legacy)
      pointer = File.join(workspace, ".reach-home", "state", "relocation.json")
      if File.file?(pointer)
        data = begin
          JSON.parse(File.read(pointer))
        rescue StandardError
          nil
        end
        return false if data.is_a?(Hash) && data["phase"] == "completed"
      end
      File.file?(File.join(legacy, "install.yml")) || File.directory?(File.join(legacy, "plugin"))
    end

    def record_destination(destination)
      directory = File.dirname(File.expand_path(__FILE__))
      return unless File.basename(directory) == "bootstrap"

      File.write(File.join(directory, "last-install.txt"), "#{destination}\n")
    rescue StandardError
      nil
    end

    def codex_step(destination)
      return if ENV["REACH_CODEX_SETUP"] == "0"
      return unless codex_present?

      exe = File.join(destination, "exe", "reach")
      terminal = answer_terminal
      if terminal
        begin
          began = log_clock
          ran = system(RbConfig.ruby, exe, "codex", "configure", in: terminal)
          log_step("codex", began, "ran" => true, "ok" => ran ? true : false)
        ensure
          terminal.close unless terminal.equal?($stdin)
        end
      else
        log_write("kind" => "step", "step" => "codex", "ran" => false)
        puts "rEach install: to let rEach set up Codex, run this in a terminal: \"#{RbConfig.ruby}\" \"#{exe}\" codex configure"
      end
    rescue StandardError
      nil
    end

    def answer_terminal
      return $stdin if $stdin.tty?
      return nil if Gem.win_platform? || !$stdout.tty?

      File.open("/dev/tty", "r")
    rescue StandardError
      nil
    end

    def codex_present?
      home = ENV["CODEX_HOME"].to_s.empty? ? File.join(user_home, ".codex") : expand_home(ENV["CODEX_HOME"])
      return true if File.directory?(home)

      names = Gem.win_platform? ? %w[codex.exe codex.cmd codex.bat codex] : %w[codex]
      ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any? do |dir|
        names.any? { |name| File.file?(File.join(dir, name)) && File.executable?(File.join(dir, name)) }
      end
    end

    def parse(argv)
      options = {
        destination: default_destination,
        url: "https://github.com/SteveBenner/rEach/archive/refs/heads/stable.zip"
      }
      OptionParser.new do |parser|
        parser.on("--archive PATH") { |value| options[:archive] = File.expand_path(value) }
        parser.on("--url URL") { |value| options[:url] = value }
        parser.on("--destination PATH") { |value| options[:destination] = value }
        parser.on("--dovetail-revision PATH") { |value| options[:revision] = File.expand_path(value) }
      end.parse!(argv)
      raise "--archive does not exist: #{options[:archive]}" if options[:archive] && !File.file?(options[:archive])
      options
    end

    def read_revision(path)
      revision = File.read(path).strip
      raise "invalid Dovetail revision in #{path}" unless revision.match?(/\A[0-9a-f]{7,64}\z/)

      revision
    rescue Errno::ENOENT
      raise "Dovetail revision file is missing: #{path}"
    end

    def download(url, temp, name)
      path = File.join(temp, name)
      last_error = nil
      MAX_ATTEMPTS.times do |attempt|
        wait_for_download_turn
        began = log_clock
        @fetch_status = nil
        begin
          fetch(URI(url), path)
          log_step("download", began, "attempt" => attempt + 1, "url" => log_text(url), "status" => @fetch_status, "bytes" => File.size(path), "sha256" => Digest::SHA256.file(path).hexdigest)
          return path
        rescue StandardError => e
          last_error = e
          log_step("download", began, "attempt" => attempt + 1, "url" => log_text(url), "status" => @fetch_status, "error" => log_text(e.class.name), "message" => log_text(e.message))
          sleep(attempt + 1) if attempt + 1 < MAX_ATTEMPTS
        end
      end
      raise "could not download #{url}: #{last_error.message}"
    end

    def wait_for_download_turn
      now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      previous = @last_download_at || 0
      sleep(MIN_DOWNLOAD_INTERVAL_S - (now - previous)) if now - previous < MIN_DOWNLOAD_INTERVAL_S
      @last_download_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end

    def fetch(uri, path, redirects = 0)
      raise "only HTTPS archive URLs are allowed" unless uri.is_a?(URI::HTTPS)
      raise "too many archive redirects" if redirects > 5

      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      http.open_timeout = CONNECT_TIMEOUT_S
      http.read_timeout = READ_TIMEOUT_S
      request = Net::HTTP::Get.new(uri.request_uri)
      http.request(request) do |response|
        if response.is_a?(Net::HTTPRedirection)
          target = URI.join(uri, response.fetch("location"))
          return fetch(target, path, redirects + 1)
        end
        @fetch_status = response.code
        raise "archive download returned HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)
        declared = response["content-length"].to_i
        raise "archive exceeds #{MAX_BYTES} bytes" if declared > MAX_BYTES

        bytes = 0
        File.open(path, "wb", 0o600) do |file|
          response.read_body do |chunk|
            bytes += chunk.bytesize
            raise "archive exceeds #{MAX_BYTES} bytes" if bytes > MAX_BYTES

            file.write(chunk)
          end
        end
      end
    end

    def extract_archive(archive, destination)
      data = File.binread(archive)
      eocd = data.rindex("PK\x05\x06".b)
      raise "archive is not a valid ZIP file" unless eocd && data.bytesize >= eocd + 22

      count, _size, cd_offset = data.byteslice(eocd + 10, 12).unpack("vVV")
      raise "ZIP64 archives are not supported" if count == 0xFFFF || cd_offset == 0xFFFFFFFF
      raise "archive has no files" if count.zero?

      entries = read_directory(data, count, cd_offset)
      names = entries.map { |entry| entry[:name] }
      raise "archive contains an unsafe path" if names.any? { |name| unsafe_path?(name) }
      roots = names.map { |name| name.split("/", 2).first }.uniq
      raise "archive must contain one root directory" unless roots.length == 1
      links = entries.select { |entry| entry[:symlink] }
      files = entries.reject { |entry| entry[:symlink] || entry[:name].end_with?("/") }.map { |entry| [entry[:name], entry] }.to_h
      links.each { |link| link[:source] = link_source(data, link, files, roots.first) }
      raise "archive is too large when unpacked" if entries.sum { |entry| entry[:size] } > MAX_UNPACKED_BYTES

      FileUtils.mkdir_p(destination)
      (entries - links).each { |entry| write_entry(data, entry, destination) }
      links.each { |link| write_content(inflate(data, link[:source]), File.join(destination, link[:name]), link[:source][:mode]) }
      root = File.join(destination, roots.first)
      raise "archive root was not created" unless Dir.exist?(root)

      root
    end

    def read_directory(data, count, offset)
      entries = []
      count.times do
        raise "archive directory is corrupt" unless data.byteslice(offset, 4) == "PK\x01\x02".b

        _made, _need, flags, method, _time, _date, _crc, csize, size, nlen, elen, clen, _disk, _int, ext, local =
          data.byteslice(offset + 4, 42).unpack("vvvvvvVVVvvvvvVV")
        name = data.byteslice(offset + 46, nlen).force_encoding("UTF-8")
        raise "encrypted archive entries are not supported" if flags & 1 == 1

        entries << { name: name, method: method, csize: csize, size: size, local: local, mode: (ext >> 16) & 0o177777 }
        offset += 46 + nlen + elen + clen
      end
      entries.each { |entry| entry[:symlink] = (entry[:mode] & 0o170000) == 0o120000 }
      entries
    end

    def link_source(data, link, files, root)
      target = inflate(data, link).force_encoding("UTF-8")
      raise "archive contains an unsafe symbolic link: #{link[:name]}" if target.empty? || target.include?("\0") || target.include?("\\") || target.start_with?("/") || target.match?(/\A[A-Za-z]:/) || target.end_with?("/")

      parts = File.dirname(link[:name]).split("/")
      target.split("/").each do |part|
        next if part.empty? || part == "."

        raise "archive contains an unsafe symbolic link: #{link[:name]}" if part == ".." && parts.length <= 1

        part == ".." ? parts.pop : parts << part
      end
      source = files[parts.join("/")]
      raise "archive contains an unsafe symbolic link: #{link[:name]}" unless source && parts.first == root

      source
    end

    def write_entry(data, entry, destination)
      target = File.join(destination, entry[:name])
      if entry[:name].end_with?("/")
        FileUtils.mkdir_p(target)
        return
      end

      write_content(inflate(data, entry), target, entry[:mode])
    end

    def inflate(data, entry)
      raise "archive entry is corrupt" unless data.byteslice(entry[:local], 4) == "PK\x03\x04".b

      nlen, elen = data.byteslice(entry[:local] + 26, 4).unpack("vv")
      body = data.byteslice(entry[:local] + 30 + nlen + elen, entry[:csize])
      content = case entry[:method]
                when 0 then body
                when 8 then Zlib::Inflate.new(-Zlib::MAX_WBITS).inflate(body)
                else raise "unsupported archive compression method #{entry[:method]}"
                end
      raise "archive entry size mismatch: #{entry[:name]}" unless content.bytesize == entry[:size]

      content
    end

    def write_content(content, target, mode)
      FileUtils.mkdir_p(File.dirname(target))
      File.open(target, "wb") { |file| file.write(content) }
      File.chmod((mode & 0o111).zero? ? 0o644 : 0o755, target)
    end

    def unsafe_path?(name)
      name.empty? || name.include?("\0") || name.include?("\\") || name.start_with?("/") || name.match?(/\A[A-Za-z]:/) || name.split("/").include?("..")
    end

    def install(source, destination)
      began = log_clock
      backup = nil
      if File.exist?(destination) || File.symlink?(destination)
        backup_dir = File.join(File.dirname(destination), ".backup")
        FileUtils.mkdir_p(backup_dir)
        backup = File.join(backup_dir, "#{File.basename(destination)}-#{Time.now.utc.strftime("%Y%m%d%H%M%S")}-#{SecureRandom.hex(3)}")
        FileUtils.mv(destination, backup)
      end
      FileUtils.mv(source, destination)
      log_step("move", began, "what" => "install", "destination" => destination, "backup" => backup ? true : false)
      puts "previous install kept at #{backup}" if backup
    rescue StandardError
      FileUtils.mv(backup, destination) if backup && File.exist?(backup) && !File.exist?(destination)
      raise
    end
  end
end

exit ReachInstall.run(ARGV) if $PROGRAM_NAME == __FILE__
