{
  "description": "rEach: greet the student and load the persona at session start, and enroll the student while rEach is locked",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${CLAUDE_PLUGIN_ROOT}/exe/reach\" hello",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${CLAUDE_PLUGIN_ROOT}/exe/reach\" gate enroll --harness claude-code",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
