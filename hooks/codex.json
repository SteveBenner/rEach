{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${PLUGIN_ROOT}/exe/reach\" hello",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${PLUGIN_ROOT}/exe/reach\" gate enroll --harness claude-code",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
